// PatioFinder build configuration.
//
// This file ships with a placeholder so the project builds and runs out of the
// box in DEMO MODE (bundled sample patios). To use live Google Places data,
// replace the placeholder below with your own key.
//
// Tip: to keep your key out of git after editing it, run:
//   git update-index --skip-worktree Config.xcconfig

GOOGLE_PLACES_API_KEY = YOUR_GOOGLE_PLACES_API_KEY
